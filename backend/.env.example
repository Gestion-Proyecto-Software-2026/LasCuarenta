DATABASE_URL=postgres://cartas:cartas_dev_password@localhost:5432/cartas_online
JWT_SECRET=cambia_esto
# Secreto servidor-a-servidor para POST /interno/partidas (nunca lo usa el cliente).
# Ver docs/analisis_funcional_app.md §5 (Interno) y docs/arquitectura.md §5.
INTERNAL_API_SECRET=cambia_esto_tambien
# host:puerto del servidor de partida que se entrega al cliente como servidor_direccion
# (docs/analisis_funcional_app.md §5).
GAME_SERVER_ADDRESS=localhost:9000
PORT=3000
# Coste del bcrypt que el backend aplica sobre el password_hash que envía el cliente
BCRYPT_SALT_ROUNDS=10
# Caducidad del token JWT que firma POST /auth/login
JWT_EXPIRES_IN=24h
# Envío de correo para POST /auth/recuperar (ver docs/analisis_funcional_app.md §5).
# En desarrollo podéis usar un SMTP de pruebas (p. ej. Mailtrap o Ethereal).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@cartas-online.local
# Minutos de validez del código de recuperación enviado por correo
RECOVERY_CODE_TTL_MIN=15
