anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.231, 0.165, 1)

[node name="Centro" type="CenterContainer" parent="."]
