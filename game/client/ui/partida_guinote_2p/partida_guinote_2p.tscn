# Mano empieza en anchor_top=0.7 (tapete_guinote.tscn) y las cartas se dibujan
# con z_index >= 0 (carta_guinote.gd), que en Godot se compara de forma
# absoluta en toda la capa de lienzo —no solo entre hermanos—, así que un
# botón sin z_index propio puede quedar tapado por el abanico de cartas pese
# a estar más arriba en el árbol. Se sube el panel para no solaparse con la
# mano y, además, se le da un z_index alto como red de seguridad.
z_index = 50
alignment = 1
theme_override_constants/separation = 10

